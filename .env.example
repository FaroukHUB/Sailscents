# Base de donnees PostgreSQL (Neon recommande — https://neon.tech, offre gratuite)
DATABASE_URI=postgres://user:password@ep-xxxx.neon.tech/sailscents?sslmode=require

# Chaine secrete Payload (generer une valeur longue et aleatoire, ex: openssl rand -base64 32)
PAYLOAD_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# URL publique du site (utilisee pour les metadonnees SEO, Open Graph, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Stripe (paiement) — a renseigner quand l'integration complete sera developpee
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
